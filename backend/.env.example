# CareRoute-X Backend Environment Configuration
# Copy this file to .env and configure with your Supabase and application settings.

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials (managed by project administrator)
SUPABASE_URL=https://rkyrzctczohppspnzfxp.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWKS_URL=https://rkyrzctczohppspnzfxp.supabase.co/auth/v1/.well-known/jwks.json
# Optional: Legacy HS256 JWT secret for verifying older sessions
# SUPABASE_JWT_SECRET=your-supabase-legacy-jwt-secret
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the Next.js browser environment
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database URL (Supabase PostgreSQL)
# Example: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# Or synchronous: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Gemini & AI Triage Configuration (Stage 4B)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
DDXPLUS_DATA_PATH=D:\22687585.zip

